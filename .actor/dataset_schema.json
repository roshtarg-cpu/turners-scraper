{
  "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
  "actorSpecification": 1,
  "fields": {
    "url": {
      "type": "string",
      "title": "URL",
      "description": "Link to the car listing on Turners.co.nz"
    },
    "title": {
      "type": "string",
      "title": "Title",
      "description": "Car title (year, make, model)"
    },
    "year": {
      "type": "string",
      "title": "Year",
      "description": "Year of manufacture"
    },
    "make": {
      "type": "string",
      "title": "Make",
      "description": "Car manufacturer"
    },
    "model": {
      "type": "string",
      "title": "Model",
      "description": "Car model"
    },
    "price": {
      "type": "string",
      "title": "Price",
      "description": "Price in NZD"
    },
    "location": {
      "type": "string",
      "title": "Location",
      "description": "Turners branch location"
    },
    "odometer": {
      "type": "string",
      "title": "Odometer",
      "description": "Kilometers driven"
    },
    "transmission": {
      "type": "string",
      "title": "Transmission",
      "description": "Transmission type (Automatic/Manual)"
    },
    "fuelType": {
      "type": "string",
      "title": "Fuel Type",
      "description": "Fuel type (Petrol/Diesel/Hybrid/Electric)"
    },
    "engine": {
      "type": "string",
      "title": "Engine",
      "description": "Engine size in cc"
    },
    "color": {
      "type": "string",
      "title": "Color",
      "description": "Exterior color"
    },
    "bodyStyle": {
      "type": "string",
      "title": "Body Style",
      "description": "Body style (Sedan/SUV/Hatchback/etc.)"
    },
    "driveType": {
      "type": "string",
      "title": "Drive Type",
      "description": "Drive type (2WD/4WD/AWD)"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Car description"
    },
    "images": {
      "type": "array",
      "title": "Images",
      "description": "Car images"
    },
    "scrapedAt": {
      "type": "string",
      "title": "Scraped At",
      "description": "Timestamp when the data was scraped"
    }
  },
  "views": {
    "overview": {
      "title": "Overview",
      "transformation": {
        "fields": ["title", "price", "year", "odometer", "location", "url"]
      },
      "display": {
        "component": "table",
        "properties": {
          "title": {
            "label": "Car",
            "format": "text"
          },
          "price": {
            "label": "Price (NZD)",
            "format": "text"
          },
          "year": {
            "label": "Year",
            "format": "text"
          },
          "odometer": {
            "label": "Kilometers",
            "format": "text"
          },
          "location": {
            "label": "Location",
            "format": "text"
          },
          "url": {
            "label": "URL",
            "format": "link"
          }
        }
      }
    }
  }
}
